# ═══════════════════════════════════════════════════════════════════════════════
# AI Chat Herder — Environment Variable Template
# ───────────────────────────────────────────────
# Quick start (local dev):
#   cp .env.template .env && docker compose up --build -d
#
# All defaults below work for local development — no editing required.
# ⚠  Before deploying to production, replace every value marked "change for prod".
# ═══════════════════════════════════════════════════════════════════════════════

# ── ASP.NET Core ──────────────────────────────────────────────────────────────
# Use "Production" when deploying; "Development" enables detailed error pages.
ASPNETCORE_ENVIRONMENT=Development

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=chatherder
POSTGRES_USER=chatherder
POSTGRES_PASSWORD=chatherder_dev           # change for prod

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=chatherder_dev              # change for prod

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_USER=chatherder
RABBITMQ_PASSWORD=chatherder_dev           # change for prod
RABBITMQ_VHOST=chatherder

# ── JWT ───────────────────────────────────────────────────────────────────────
# ⚠  Production: replace with a real random secret → openssl rand -base64 48
JWT_SECRET_KEY=dev-only-secret-key-not-for-production-use-replace-me-padding00
JWT_ISSUER=ChatHerder
JWT_AUDIENCE=ChatHerderClient

# ── SMTP (password reset emails) ──────────────────────────────────────────────
# Local dev: run MailHog to capture sent emails without a real SMTP server:
#   docker run -d -p 1025:1025 -p 8025:8025 mailhog/mailhog
# Then open http://localhost:8025 to read outgoing emails.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=dev
SMTP_PASSWORD=dev
SMTP_FROM_ADDRESS=noreply@localhost

# ── E2E Testing ───────────────────────────────────────────────────────────────
# URL the Playwright runner uses to reach the app inside Docker Compose.
BASE_URL=http://frontend
E2E_REPORT_DIR=./e2e-reports
