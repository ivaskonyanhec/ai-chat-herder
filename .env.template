# ═══════════════════════════════════════════════════════════════════════════════
# AI Chat Herder — Environment Variable Template
# ───────────────────────────────────────────────
# 1. Copy this file:   cp .env.template .env
# 2. Fill in every value marked <CHANGE_ME>
# 3. Never commit .env — it is listed in .gitignore
# ═══════════════════════════════════════════════════════════════════════════════

# ── ASP.NET Core ──────────────────────────────────────────────────────────────
# Use "Production" when deploying; "Development" enables detailed error pages.
ASPNETCORE_ENVIRONMENT=Development

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=chatherder
POSTGRES_USER=chatherder
POSTGRES_PASSWORD=<CHANGE_ME>

# ── Redis ─────────────────────────────────────────────────────────────────────
# Used by StackExchange.Redis as: redis,password=<REDIS_PASSWORD>,abortConnect=false
REDIS_PASSWORD=<CHANGE_ME>

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_USER=chatherder
RABBITMQ_PASSWORD=<CHANGE_ME>
# Virtual host that isolates this app's queues
RABBITMQ_VHOST=chatherder

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 64
# Access token TTL: 15 min | Refresh token TTL: 7 days (AGENT.md §7)
JWT_SECRET_KEY=<CHANGE_ME>
JWT_ISSUER=ChatHerder
JWT_AUDIENCE=ChatHerderClient

# ── SMTP (password reset emails) ──────────────────────────────────────────────
# For local dev, run a MailHog container or use a free Mailtrap sandbox.
# MailHog: docker run -p 1025:1025 -p 8025:8025 mailhog/mailhog
#   SMTP_HOST=localhost  SMTP_PORT=1025  (no auth needed)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=<CHANGE_ME>
SMTP_PASSWORD=<CHANGE_ME>
SMTP_FROM_ADDRESS=noreply@example.com

# ── E2E Testing ───────────────────────────────────────────────────────────────
# URL the Playwright runner uses to reach the app.
# Inside Docker Compose: http://frontend  (container-name DNS)
# Running locally against docker compose: http://localhost
BASE_URL=http://frontend
# Host directory where Playwright HTML/JSON reports are written after a Docker run.
E2E_REPORT_DIR=./e2e-reports
