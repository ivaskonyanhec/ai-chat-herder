# AI Chat Herder - runnable local example environment.
# These values are for local development and CI smoke runs only.
# Do not reuse them for shared, staging, or production environments.

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development

# PostgreSQL
POSTGRES_DB=chatherder
POSTGRES_USER=chatherder
POSTGRES_PASSWORD=local_postgres_password

# Redis
REDIS_PASSWORD=local_redis_password

# RabbitMQ
RABBITMQ_USER=chatherder
RABBITMQ_PASSWORD=local_rabbitmq_password
RABBITMQ_VHOST=chatherder

# JWT
JWT_SECRET_KEY=local_dev_secret_key_for_ai_chat_herder_please_change_before_any_shared_use_1234567890
JWT_ISSUER=ChatHerder
JWT_AUDIENCE=ChatHerderClient

# SMTP
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=local
SMTP_PASSWORD=local
SMTP_FROM_ADDRESS=noreply@example.com

# E2E Testing
BASE_URL=http://frontend
E2E_REPORT_DIR=./e2e-reports
