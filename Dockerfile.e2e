# Playwright E2E runner — headless Chromium in Docker.
# Build context: project root (e2e/ subdirectory is copied in).
FROM mcr.microsoft.com/playwright:v1.59.1-noble

WORKDIR /e2e

# Install Node dependencies first (cached layer on package-lock.json changes).
COPY e2e/package.json e2e/package-lock.json ./
RUN npm ci

# Copy test sources.
COPY e2e/ ./

# Reports are written here; host mounts this path for post-run inspection.
RUN mkdir -p /e2e-reports

# BASE_URL must point to the frontend service (e.g. http://frontend inside Docker).
ENV BASE_URL=http://frontend

# Run typecheck + all E2E/UAT tests and write agent-readable reports.
ENV E2E_REPORTS_ROOT=/e2e-reports
CMD ["npm", "run", "test:all"]
