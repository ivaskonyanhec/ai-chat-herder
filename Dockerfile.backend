# ─── Stage 1: Build ───────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /app

# Copy solution + project manifests first — these change rarely, so dotnet
# restore runs from cache on most rebuilds (only re-runs when .csproj changes).
COPY ChatHerder.sln ./
COPY src/ChatHerder.Domain/ChatHerder.Domain.csproj                 src/ChatHerder.Domain/
COPY src/ChatHerder.Application/ChatHerder.Application.csproj       src/ChatHerder.Application/
COPY src/ChatHerder.Infrastructure/ChatHerder.Infrastructure.csproj src/ChatHerder.Infrastructure/
COPY src/ChatHerder.API/ChatHerder.API.csproj                       src/ChatHerder.API/
COPY tests/ChatHerder.Unit.Tests/ChatHerder.Unit.Tests.csproj       tests/ChatHerder.Unit.Tests/
COPY tests/ChatHerder.Integration.Tests/ChatHerder.Integration.Tests.csproj tests/ChatHerder.Integration.Tests/

RUN dotnet restore

# Copy full source and publish the API project
COPY src/ src/
COPY tests/ tests/
RUN dotnet publish src/ChatHerder.API/ChatHerder.API.csproj \
    -c Release \
    -o /app/publish

# ─── Stage 2: Runtime ─────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app

# Run as the non-root user built into official .NET container images.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl libgssapi-krb5-2 \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /app/uploads \
    && chown -R $APP_UID:$APP_UID /app

COPY --from=build --chown=$APP_UID:$APP_UID /app/publish .
USER $APP_UID

# ASP.NET Core images expose 8080 by default since .NET 8+
EXPOSE 8080

ENTRYPOINT ["dotnet", "ChatHerder.API.dll"]
